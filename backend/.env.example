PORT=5005

# ── PostgreSQL ──────────────────────────────────────────────────
# Full connection string (Neon, Render, or a local Postgres server).
# SSL is applied automatically for any non-localhost host.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Frontend origin (CORS) ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
# Preferred: bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
ADMIN_PASSWORD_HASH=
# Fallback only (plaintext) — used if ADMIN_PASSWORD_HASH is not set.
# ADMIN_PASSWORD=

# ── Gmail SMTP ────────────────────────────────────────────────
# 1. Go to myaccount.google.com -> Security -> 2-Step Verification -> App passwords
# 2. Generate an App Password for "Mail"
# 3. Paste the 16-character result as EMAIL_PASS (NOT your regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
NOTIFY_WHATSAPP=

# ── AI (Groq) ────────────────────────────────────────────────
GROQ_API_KEY=

# ── Transactional email (Resend) ────────────────────────────
RESEND_API_KEY=
